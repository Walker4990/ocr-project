# ===== DocuLens 앱 설정 =====
# 이 파일을 복사해 로컬 설정 파일로 쓰고, 실제 값은 저장소에 커밋하지 않는다.

# --- 데이터베이스 / 큐 ---
POSTGRES_USER=doculens
POSTGRES_PASSWORD=change_me
POSTGRES_DB=doculens
DATABASE_URL=postgresql+psycopg://doculens:change_me@localhost:5432/doculens
REDIS_URL=redis://localhost:6379/0

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
# IP당 분당 허용 요청 수 (0이면 끔, /health는 제외)
RATE_LIMIT_PER_MINUTE=120
LOG_LEVEL=INFO
# true면 JSON 로그, false면 콘솔용 로그
LOG_JSON=true

# --- 업로드 / 보관 정책 ---
UPLOAD_DIR=./data/uploads
UPLOAD_MAX_MB=10
RETENTION_DAYS=7

# --- OCR 엔진 (기본은 CPU) ---
# 등록된 엔진 이름만 쓸 수 있다. 현재는 paddleocr (이후 tesseract, paddleocr_vl 예정)
OCR_ENGINE=paddleocr
# CPU가 기본이다. GPU 환경에서만 1로 바꾼다
OCR_USE_GPU=0

# --- LLM 추출 (옵트인) ---
# ANTHROPIC_API_KEY가 비어 있으면 LLM 기능은 자동으로 비활성화된다.
# LLM에는 이미지가 아닌 OCR 텍스트만 전송한다.
LLM_ENABLED=false
ANTHROPIC_API_KEY=
LLM_MODEL=
LLM_DAILY_CALL_LIMIT=100
LLM_TIMEOUT_SECONDS=30

# --- 프론트엔드 ---
NEXT_PUBLIC_API_URL=http://localhost:8000


# ===== Task Master CLI (선택) =====
# 현재 설정은 claude-code 공급자라 아래 키는 필요 없다. 다른 공급자로 바꿀 때만 사용한다.
PERPLEXITY_API_KEY=       # Optional: Format: pplx-...
OPENAI_API_KEY=           # Optional, for OpenAI models. Format: sk-proj-...
GOOGLE_API_KEY=           # Optional, for Google Gemini models.
MISTRAL_API_KEY=          # Optional, for Mistral AI models.
XAI_API_KEY=              # Optional, for xAI AI models.
GROQ_API_KEY=             # Optional, for Groq models.
OPENROUTER_API_KEY=       # Optional, for OpenRouter models.
AZURE_OPENAI_API_KEY=     # Optional, for Azure OpenAI models (requires endpoint in .taskmaster/config.json).
OLLAMA_API_KEY=           # Optional: For remote Ollama servers that require authentication.
GITHUB_API_KEY=           # Optional: For GitHub import/export features. Format: ghp_... or github_pat_...
